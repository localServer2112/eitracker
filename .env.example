# Base URL for the vehicle/van tracking API. Leave unset to use the dev/prod proxy default (/api/v1).
VITE_API_BASE=/api/v1
# Base URL for the freezer tracking API. Leave unset to use the dev/prod proxy default (/freezer-api/v1).
VITE_FREEZER_API_BASE=/freezer-api/v1
# Optional Mapbox token; enables the traffic layer on the map when set.
VITE_MAPBOX_TOKEN=pk.your-token-here
